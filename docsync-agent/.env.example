# GitHub Authentication
# Personal access token fallback (classic: repo scope; fine-grained: contents,
# pull requests, and webhooks write). Leave blank to force OAuth sign-in.
GITHUB_TOKEN=

# GitHub OAuth App (optional). Set both to enable "Continue with GitHub".
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Webhooks
# Public HTTPS URL of /api/v1/webhooks/github. The Render blueprint sets this
# automatically; use an ngrok/cloudflared URL for local webhook testing.
PUBLIC_WEBHOOK_URL=https://docripple-api.onrender.com/api/v1/webhooks/github
GITHUB_WEBHOOK_SECRET=docripple-secret

# CORS
# FRONTEND_URL is the primary browser origin. ALLOWED_ORIGINS is a
# comma-separated list of additional origins. Vercel preview URLs
# (*.vercel.app), Cloudflare Pages (*.pages.dev), and localhost ports are
# always accepted by the built-in regex.
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Embedding backend
# tfidf uses NumPy only and keeps the Vercel function bundle under 500 MB
# (fastembed is not installed by default and never downloads ONNX weights).
# Set to "fastembed" only after installing it manually: pip install fastembed
EMBEDDING_MODE=tfidf

# Execution mode
# "inline" runs each job inside the request that triggers it, which is required
# on Vercel (background tasks freeze after the response). Use "queue" on a
# long-running host such as Render/Fly to drain the queue in the background.
EXECUTION_MODE=inline

# LLM Provider Configuration (OpenRouter for the Render deployment)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen-2.5-coder-32b-instruct

# SQLite Storage Configuration
# Local development:
SQLITE_DB_PATH=docsync_context.db
CHECKPOINT_DB_PATH=:memory:
# Render production (already configured in render.yaml):
# SQLITE_DB_PATH=/tmp/docsync_context.db
# CHECKPOINT_DB_PATH=/tmp/docsync_checkpoints.db

# Application & Logging
LOG_LEVEL=INFO
MAX_RETRIES=2
