# GitHub Authentication
# Personal access token fallback (classic: repo scope; fine-grained: contents,
# pull requests, and webhooks write). Leave blank to force OAuth sign-in.
GITHUB_TOKEN=ghp_your_github_token_here

# GitHub OAuth App (optional). Set both to enable "Continue with GitHub".
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Webhooks
# Full public HTTPS URL of /api/v1/webhooks/github (ngrok, cloudflared, etc.).
# Leave blank for local-only use; the dashboard's "Sync latest commit" button
# will still run the pipeline without webhooks.
PUBLIC_WEBHOOK_URL=
GITHUB_WEBHOOK_SECRET=docripple-secret

# Frontend origin used by the OAuth callback redirect
FRONTEND_URL=http://localhost:5173

# LLM Provider Configuration (OpenAI, OpenRouter, Groq, Ollama, etc.)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# SQLite Storage Configuration
SQLITE_DB_PATH=docsync_context.db
CHECKPOINT_DB_PATH=:memory:

# Application & Logging
LOG_LEVEL=INFO
MAX_RETRIES=2
