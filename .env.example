# GitHub Webhook & API Configuration
GITHUB_WEBHOOK_SECRET=dev-secret
GITHUB_TOKEN=ghp_your_github_token_here

# LLM Provider Configuration (OpenAI, OpenRouter, Groq, Ollama, etc.)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# LLM Fallback Configuration (OpenRouter when primary hits rate limits)
FALLBACK_LLM_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_LLM_API_KEY=your_openrouter_api_key_here
FALLBACK_LLM_MODEL=qwen/qwen-2.5-coder-32b-instruct
OPENROUTER_API_KEY=your_openrouter_api_key_here

# SQLite Storage Configuration
SQLITE_DB_PATH=docsync_context.db
CHECKPOINT_DB_PATH=:memory:

# Application & Logging
LOG_LEVEL=INFO
MAX_RETRIES=2
